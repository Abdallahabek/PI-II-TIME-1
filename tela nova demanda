<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nova Demanda - Development Demand Tracker</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-brand">
                <div class="logo-icon">DT</div>
                <span style="font-size: 0.9rem; line-height: 1.1;">Development Demand<br>Tracking System</span>
            </div>
            <div class="mt-3">
                <a href="dashboard.html" class="nav-link">
                    <i class="fa-solid fa-border-all"></i> Dashboard
                </a>
                <a href="demandas.html" class="nav-link active">
                    <i class="fa-regular fa-clipboard"></i> Demandas
                </a>
                <a href="#" class="nav-link">
                    <i class="fa-solid fa-gear"></i> Configurações
                </a>
            </div>
        </div>
        <!-- Main Content -->
        <div class="main-content">
            <div class="topbar">
                <h5 class="m-0 text-dark">Bem-vindo, Aluno 2</h5>
                <div class="user-info">
                    Bem-vindo, Aluno 2
                    <div class="user-avatar"><i class="fa-solid fa-user"></i></div>
                </div>
            </div>
            <div class="p-4">
                <div class="card card-custom p-4">
                    <h4 class="mb-4 text-dark fw-normal">Nova Demanda</h4>
                    
                    <form action="demandas.html" method="GET">
                        <div class="mb-3">
                            <label class="form-label text-muted">Título da Demanda</label>
                            <input type="text" class="form-control" placeholder="Ex: Ajuste no fluxo de login">
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label text-muted">Solicitante</label>
                                <select class="form-select">
                                    <option>João Silva</option>
                                    <option>Maria Costa</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Tipo de Demanda</label>
                                <div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="tipo" id="bug" checked>
                                        <label class="form-check-label" for="bug">Bug</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="tipo" id="feature">
                                        <label class="form-check-label" for="feature">Feature</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="tipo" id="melhoria">
                                        <label class="form-check-label" for="melhoria">Melhoria</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Prioridade</label>
                                <select class="form-select">
                                    <option>Alta</option>
                                    <option>Média</option>
                                    <option>Baixa</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted">Data Desejada</label>
                                <div class="input-group">
                                    <input type="date" class="form-control">
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted">Descrição Detalhada</label>
                            <textarea class="form-control" rows="5" placeholder="Descrição Detalhada..."></textarea>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted">Arquivos Anexos</label><br>
                            <button type="button" class="btn btn-light border text-muted"><i class="fa-solid fa-file-arrow-up"></i> Adicionar Arquivo</button>
                        </div>
                        <hr class="text-secondary">
                        <div class="d-flex justify-content-end">
                            <a href="demandas.html" class="btn btn-secondary me-2 bg-secondary border-0">Cancelar</a>
                            <button type="submit" class="btn btn-primary" style="background-color: #1e73be; border: none;">Salvar Demanda</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
